{
  "name": "javaloka-coffee",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": { "node": ">=20 <25" },
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch src/server/index.js\"",
    "build": "npm run prisma:migrate && npm run prisma:generate && npm run seed && vite build",
    "start": "node src/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "migrate:legacy": "node scripts/migrate-laravel-data.js"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.0",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "@prisma/client": "^6.13.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "prisma": "^6.13.0",
    "react-router-dom": "^7.7.1",
    "vite": "^7.0.6",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.0.0",
    "sql.js": "^1.13.0",
    "supertest": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
